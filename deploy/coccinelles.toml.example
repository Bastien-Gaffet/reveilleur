# Réveilleur du serveur « Les coccinelles »
listen = "0.0.0.0:25566"
backend = "127.0.0.1:25567"
limbo = "127.0.0.1:30066"
ads_url = "http://127.0.0.1:8080/API/"
instance_id = "698be81e-1a1e-4648-bd84-0abe54eae2d8"
instance_name = "Coccinelles01"
amp_user = "reveilleur"
amp_password_file = "/etc/reveilleur/amp-password"
# Arrêt du serveur après 30 min sans joueur (0 = jamais).
idle_stop_minutes = 30
ready_grace_seconds = 3

# Paquet clientbound play « transfer » par protocole (packets.json du serveur).
[transfer_packet_ids]
"777" = 132   # 26.3
