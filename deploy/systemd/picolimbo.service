[Unit]
Description=PicoLimbo - salle d attente partagée des serveurs en veille
After=network.target

[Service]
WorkingDirectory=/opt/picolimbo/limbo
ExecStart=/opt/picolimbo/pico_limbo --skip-banner -c server.toml
Restart=always
RestartSec=5
DynamicUser=yes
MemoryMax=64M
CPUQuota=25%

[Install]
WantedBy=multi-user.target
